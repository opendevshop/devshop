{
    "name": "drupal/devshop",
    "version": "2.0.0-dev",
    "description": "DevShop is a hosting management tool built on Drupal, offering smart defaults to get started quickly and enterprise-grade tools for developers & operators. THIS IS A PET PROJECT. Don't expect much.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/opendevshop/devshop/tree/d2",
    "support": {
        "docs": "https://github.com/opendevshop/devshop"
    },
    "repositories": {
        "drupal": {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    },
    "require": {
        "composer/installers": "^2.3",
        "drupal/cms": "~1.0.3",
        "drupal/core-composer-scaffold": "^11.1.4",
        "drupal/core-project-message": "^11.1.4",
        "drupal/core-recommended": "^11.1.4",
        "drupal/drupal_cms_starter": "~1.0.3",
        "drupal/recipe_installer_kit": "^1-alpha3@alpha",
        "drupal/site": "^2.2@RC",
        "drush/drush": "^13"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "php-http/discovery": true
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-paths": {
            "web/core": ["type:drupal-core"],
            "web/libraries/{$name}": ["type:drupal-library"],
            "web/modules/contrib/{$name}": ["type:drupal-module"],
            "web/profiles/contrib/{$name}": ["type:drupal-profile"],
            "web/themes/contrib/{$name}": ["type:drupal-theme"],
            "drush/Commands/contrib/{$name}": ["type:drupal-drush"],
            "web/modules/custom/{$name}": ["type:drupal-custom-module"],
            "web/profiles/custom/{$name}": ["type:drupal-custom-profile"],
            "recipes/{$name}": ["type:drupal-recipe"],
            "web/themes/custom/{$name}": ["type:drupal-custom-theme"]
        },
        "drupal-core-project-message": {
            "include-keys": ["homepage", "support"],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                   </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed DevShop!    </>",
                "<bg=blue;fg=white>                                                   </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Follw the code: https://github.com/opendevshop/devshop/tree/d2/docs"
            ]
        }
    },
    "scripts": {
        "post-install-cmd": [
            "cd web/profiles && ln -sf ../../src/profiles/devshop_installer"
        ]
    }
}
